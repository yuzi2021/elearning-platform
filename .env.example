# Local development defaults. Production must replace SECRET_KEY, set
# DEBUG=False, and explicitly configure hosts, origins, and DATABASE_URL.
SECRET_KEY=django-insecure-local-development-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# Leave blank for the local SQLite fallback. Docker Compose supplies ordinary
# PostgreSQL. For Neon, use its pooled URL and retain sslmode=require.
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=True

# Deterministic demo data
SEED_DEMO_DATA=True
DEMO_EXAMINER_PASSWORD=replace-for-a-non-public-demo
DEMO_PASSWORD=replace-for-a-non-public-demo
DEMO_ADMIN_PASSWORD=replace-for-a-non-public-demo

# Optional Redis/Celery/Channels infrastructure
REDIS_URL=
CACHE_URL=
CELERY_ENABLED=False
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional external NLP API (keyword analysis is the fallback)
TEXTRAZOR_API_KEY=
EXTERNAL_API_TIMEOUT=5
TEXTRAZOR_TIMEOUT=15
LOG_LEVEL=INFO
ALLOW_INSTRUCTOR_REGISTRATION=True

# Optional email delivery (console backend is the default)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional persistent media via any S3-compatible object store. When omitted in
# production, uploads are disabled so the app never pretends local disk persists.
MEDIA_UPLOADS_ENABLED=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
